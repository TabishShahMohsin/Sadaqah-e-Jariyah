# Ignore everything
*

# But keep these root files
!.gitignore
!README.md
!LICENSE

# Allow all Python files in all folders
!*.py
!*/**/*.py

# Allow all json files in all folders
!*.json
!*/**/*.json
# Website (local browser + future hosted site)
!site/
!site/**
!functions/
!functions/**

# Archive tooling (content files stay out of git; the catalog describes them)
!CONVENTIONS.md
!DEPLOY-HUGGINGFACE.md
!CLAUDE.md
!DEPLOY.md
!catalog/
!catalog/**
!tools/
!tools/**
!worker/
!worker/**
!.github/
!.github/**
worker/node_modules/
.sej-cache/
__pycache__/
site/index.json
!setup/
!setup/**

# Hugging Face write token (never commit)
catalog/hf-config.json

# AI provider key (never commit)
catalog/llm-config.json
